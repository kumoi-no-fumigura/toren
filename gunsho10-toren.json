 "poems": [
  {
   "seq": "1",
   "text": "霞たつ春のみ空とおもはすはけふも雪けの雲とみてまし",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 25,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "櫻花ちりなん後の面かけに朝ゐる雲のたゝんすらむ",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "櫻さくなからの山に風吹はそらにもみゆる志賀のうら波",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "曉のしるくもおもはぬ郭公なれもやこゑを鳴わたらなん",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "夏深みひはらのそまのいはま川結ふ手〓とに秋そこもれる",
   "kana": "",
   "speaker": "",
   "page": 25,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "難波かたあしの葉末に風吹て螢なみよる夕まくれかな",
   "kana": "",
   "speaker": "登蓮法師集",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "月かけは秋のみそらのこゝちしてよる社なけれ絕ま成けれ",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "その色とおもひもわかす花といへは秋の野ことにちる心かな",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "遇かてに覺るものは白露の玉ゐる朝のまゝの萩はら",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "はゝそはら雨とその葉の降まゝにもりのみ增る月のかけ哉",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "諸ともにみし人いかに成にけむ月はむかしにかはらさりけり",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "故里をおもひやりつゝ詠れは心ひとつに曇る月かな",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "秋風のみにしむよはのね覺にはいかゝと問し人そかなしき",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "なけくらむすかたはみねと身をつめはいかゝ露けき秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "あすよりは小田の鳴子も引かへて時雨の音にならんとすらむ",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "小夜深みまくれてわたる音聞は思ひもわかて物そかなしき",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "よそにこそかひのしらねは消たつるいく夜に成ぬ雪の下ふし",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "枝かはす契はこりぬ後のよもかゝるなけきの身とも社なれ",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "君もうし逢すは我も忘なてつれなき人そふたりんける",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "みさこゐる磯の松かねまくらにて鹽かせ寒くあかしつるかな",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "世中の人のこゝろのうき雲にくもかくれする有明の月",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "あはち島しほのとゝゐを待ほとに涼しく成りぬせとの夕風",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "ゐなのよりおまへの沖をみわたせは波まにきゆる海士の釣舟",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "むかしみし人はさなから薄氷おもひしとけはあちきなのよや",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "明ゆけは葉末にのほるゑら露の風まつ程や我かみなるらん",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "さりともとやへのしほりに入しかとそこにも老の波はより鳬",
   "kana": "",
   "speaker": "",
   "page": 26,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  }
 ],
